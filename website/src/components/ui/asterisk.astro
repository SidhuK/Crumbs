---
// The 9×9 pixel asterisk from the Crumbs app icon.
interface Props {
  class?: string;
  label?: string;
}
const { class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 9 9"
  shape-rendering="crispEdges"
  class:list={["fill-current", className]}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}>
  <path
    d="M1 0h2v2H1zM6 0h2v2H6zM2 2h2v1H2zM5 2h2v1H5zM3 3h3v1H3zM0 4h9v1H0zM3 5h3v1H3zM2 6h2v1H2zM5 6h2v1H5zM1 7h2v2H1zM6 7h2v2H6z"
  ></path>
</svg>
